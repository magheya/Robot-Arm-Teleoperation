<?xml version="1.0"?>
<robot name="my_robot_arm">

  <!-- Define materials for color -->
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <material name="blue">
    <color rgba="0.2 0.2 0.8 1"/>
  </material>

  <!-- BASE LINK (The non-moving part on the board) -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="0.02" radius="0.07"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.01"/>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.02" radius="0.07"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.01"/>
    </collision>
  </link>

  <!-- ROTATING BASE JOINT -->
  <joint name="base_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_mount_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.6" upper="2.6" effort="10" velocity="1"/> <!-- Approx +/- 150 degrees -->
  </joint>

  <!-- SHOULDER MOUNT LINK (The part that holds the shoulder servo) -->
  <link name="shoulder_mount_link">
    <visual>
      <geometry>
        <box size="0.06 0.06 0.06"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.03"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.06 0.06 0.06"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.03"/>
    </collision>
  </link>

  <!-- SHOULDER JOINT -->
  <joint name="shoulder_joint" type="revolute">
    <parent link="shoulder_mount_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/> <!-- From -90 to +90 degrees -->
  </joint>

  <!-- UPPER ARM LINK -->
  <link name="upper_arm_link">
    <visual>
      <geometry>
        <box size="0.15 0.04 0.06"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.075 0 0"/>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.15 0.04 0.06"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.075 0 0"/>
    </collision>
  </link>

  <!-- ELBOW JOINT -->
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0.15 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.6" effort="10" velocity="1"/> <!-- 0 to 150 degrees -->
  </joint>

  <!-- FOREARM LINK -->
  <link name="forearm_link">
    <visual>
      <geometry>
        <box size="0.15 0.04 0.04"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.075 0 0"/>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.15 0.04 0.04"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.075 0 0"/>
    </collision>
  </link>

  <!-- WRIST JOINT -->
  <joint name="wrist_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="gripper_base_link"/>
    <origin xyz="0.15 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="3.14" effort="10" velocity="1"/> <!-- 0 to 180 degrees -->
  </joint>

  <!-- GRIPPER BASE (The small part holding the two gripper servos) -->
  <link name="gripper_base_link">
    <visual>
      <geometry>
        <box size="0.05 0.08 0.02"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.025 0 0"/>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.08 0.02"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.025 0 0"/>
    </collision>
  </link>

  <!-- LEFT GRIPPER JOINT -->
  <joint name="left_gripper_joint" type="revolute">
    <parent link="gripper_base_link"/>
    <child link="left_finger_link"/>
    <origin xyz="0.03 0.02 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="1.57" effort="10" velocity="1"/> <!-- Changed upper limit to 90 deg -->
  </joint>

  <!-- RIGHT GRIPPER JOINT -->
  <joint name="right_gripper_joint" type="revolute">
    <parent link="gripper_base_link"/>
    <child link="right_finger_link"/>
    <origin xyz="0.03 -0.02 0" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/> <!-- Note the inverted axis -->
    <limit lower="0" upper="1.57" effort="10" velocity="1"/> <!-- Changed upper limit to 90 deg -->
  </joint>

  <!-- FINGER LINKS -->
  <link name="left_finger_link">
    <visual>
      <geometry>
        <box size="0.04 0.015 0.01"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.02 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.015 0.01"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.02 0 0"/>
    </collision>
  </link>
  <link name="right_finger_link">
    <visual>
      <geometry>
        <box size="0.04 0.015 0.01"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.02 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.015 0.01"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.02 0 0"/>
    </collision>
  </link>

</robot>